FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r app && useradd -r -g app app

# GoReleaser v2 places binaries in subdirectories matching the target platform
ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/__PROJECT_NAME__ /usr/local/bin/__PROJECT_NAME__
RUN chmod +x /usr/local/bin/__PROJECT_NAME__

USER app
WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/__PROJECT_NAME__"]
CMD ["--help"]
